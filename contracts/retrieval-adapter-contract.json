{
  "serviceId": "retrieval-adapter",
  "sourceProject": "infra-dev-scaffolding",
  "runtime": "java-spring-boot",
  "purpose": "Define production adapter boundaries for RAG retrieval while keeping the scaffold stack stable.",
  "boundaries": [
    "Business retrieval orchestration must depend on interfaces and stage services, not concrete middleware clients.",
    "Vector store adapters belong to the Java backend infrastructure boundary.",
    "Keyword search adapters belong to the Java backend retrieval boundary.",
    "Remote rerank adapters must use RemoteHttpClient and targetService=rerank-provider.",
    "Python doc-parser remains an independent FastAPI service and must not own retrieval adapters."
  ],
  "vectorStore": {
    "interface": "VectorStoreService",
    "properties": "VectorStoreProperties",
    "defaultProvider": "memory",
    "defaultImplementation": "MemoryVectorStoreService",
    "productionProviderSkeletons": [
      "pgvector"
    ],
    "sqlImplementation": "PgVectorStoreService",
    "futureProviders": [
      "milvus",
      "hosted-vector-db"
    ],
    "configKeys": [
      "app.vector-store.provider",
      "app.vector-store.collection-prefix",
      "app.vector-store.pgvector.table-name",
      "app.vector-store.pgvector.schema-initialization-enabled",
      "VECTOR_STORE_PROVIDER",
      "VECTOR_STORE_COLLECTION_PREFIX",
      "VECTOR_STORE_PGVECTOR_TABLE_NAME",
      "VECTOR_STORE_PGVECTOR_SCHEMA_INITIALIZATION_ENABLED"
    ],
    "rules": [
      "DocumentEmbeddingService writes vectors through VectorStoreService.",
      "RetrievalService searches vectors through VectorStoreService.",
      "Adapters must not assemble answer citations or prompt context.",
      "memory remains the dev/test default so scaffold smoke tests need no external middleware.",
      "PgVectorStoreService must use JdbcTemplate and @ConditionalOnProperty.",
      "pgvector table names must be validated as safe SQL identifiers."
    ]
  },
  "keywordSearch": {
    "interface": "KeywordSearchProvider",
    "properties": "KeywordSearchProperties",
    "defaultProvider": "local",
    "defaultImplementation": "LocalKeywordSearchProvider",
    "productionProviderSkeletons": [
      "bm25",
      "elasticsearch"
    ],
    "rankingImplementation": "Bm25KeywordSearchProvider",
    "remoteImplementation": "ElasticsearchKeywordSearchProvider",
    "targetService": "keyword-search-provider",
    "futureProviders": [],
    "configKeys": [
      "app.keyword-search.provider",
      "app.keyword-search.bm25.k1",
      "app.keyword-search.bm25.b",
      "app.keyword-search.bm25.minimum-score",
      "app.keyword-search.elasticsearch.base-url",
      "app.keyword-search.elasticsearch.index-prefix",
      "app.keyword-search.elasticsearch.api-key",
      "KEYWORD_SEARCH_PROVIDER",
      "KEYWORD_SEARCH_BM25_K1",
      "KEYWORD_SEARCH_BM25_B",
      "KEYWORD_SEARCH_BM25_MINIMUM_SCORE",
      "KEYWORD_SEARCH_ELASTICSEARCH_BASE_URL",
      "KEYWORD_SEARCH_ELASTICSEARCH_INDEX_PREFIX",
      "KEYWORD_SEARCH_ELASTICSEARCH_API_KEY"
    ],
    "rules": [
      "RetrievalHybridSearchService owns RRF merge and score normalization.",
      "KeywordSearchProvider implementations only return keyword candidates.",
      "Provider-specific query syntax must not leak into RetrievalService.",
      "Bm25KeywordSearchProvider must stay local and deterministic for teaching.",
      "ElasticsearchKeywordSearchProvider must use RemoteHttpClient."
    ]
  },
  "rerank": {
    "orchestrator": "RetrievalRerankService",
    "remoteClient": "RerankProviderClient",
    "properties": "RerankProperties",
    "defaultProvider": "local-demo",
    "localProvider": "local-lexical",
    "remoteProvider": "remote",
    "targetService": "rerank-provider",
    "configKeys": [
      "app.rerank.provider",
      "app.rerank.api-url",
      "app.rerank.api-key",
      "app.rerank.model",
      "RERANK_PROVIDER",
      "RERANK_API_URL",
      "RERANK_API_KEY",
      "RERANK_MODEL"
    ],
    "rules": [
      "RetrievalRerankService decides local fallback versus remote provider.",
      "RerankProviderClient only adapts the remote HTTP request and response scores.",
      "Remote calls must flow through RemoteHttpClient.",
      "Rerank provider selection must be bound by RerankProperties."
    ]
  },
  "teachingTraceFields": [
    "rank",
    "scoreExplanation",
    "retrievalSource",
    "keywordScore",
    "hybridScore",
    "rerankScore",
    "rerankProvider"
  ],
  "runtimeStatusEndpoint": {
    "path": "/api/retrieval/adapters/status",
    "controller": "RetrievalController.adapterStatus",
    "service": "RetrievalAdapterStatusService",
    "frontendApi": "RetrievalService.adapterStatus",
    "purpose": "Expose current provider configuration for the Pipeline Adapter Matrix without switching providers."
  },
  "productionProfile": {
    "springProfile": "prod-adapters",
    "activation": "SPRING_PROFILES_ACTIVE=prod,prod-adapters",
    "profileFile": "backend/src/main/resources/application-prod-adapters.yml",
    "envExample": "backend/.env.prod-adapters.example",
    "probeScript": "scripts/probe-production-adapter-profile.sh",
    "defaultProviders": {
      "vectorStore": "pgvector",
      "keywordSearch": "bm25",
      "rerank": "remote",
      "docParser": "async-recovery"
    },
    "requiresExternalServices": [
      "PostgreSQL + pgvector",
      "Python FastAPI doc-parser",
      "remote embedding provider",
      "remote LLM provider",
      "remote rerank provider"
    ],
    "optionalEscalation": [
      "KEYWORD_SEARCH_PROVIDER=elasticsearch"
    ]
  },
  "qualityGates": [
    "scripts/check-retrieval-adapter-contract.js",
    "scripts/probe-retrieval-adapters.sh",
    "scripts/probe-production-adapter-profile.sh",
    "scripts/check-scaffold-alignment.js",
    "scripts/check-contracts.sh",
    "backend retrieval service tests"
  ],
  "nonGoals": [
    "do not replace the scaffold backend stack",
    "do not move doc-parser into Spring Boot",
    "do not require Milvus, pgvector, or Elasticsearch for the default teaching path"
  ]
}
